<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Storage / audio library access
      Justification: core feature — scan and play the user's local music library
      (Music/, Download/, user-configured roots). No other media types are read.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
      Write tags into local audio files (edit song/album metadata).
      On API 29+ requestLegacyExternalStorage + existing read grant is used;
      this permission is only declared for older devices.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!--
      Network
      Justification: optional metadata enrichment (MusicBrainz year, Cover Art
      Archive images) and future remote library / scrobbler connections.
      External Explore results are not bulk-downloaded into the DB.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Foreground playback service
      Justification: keep music playing with media controls when the app is
      backgrounded or the screen is off (car / pocket use).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Wake lock
      Justification: hold a partial wake lock during active playback so the
      CPU is not suspended mid-track on some devices.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".YuriPlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YuriPlayer">

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.YuriPlayer"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="capital.yuri.yuriplayer.action.CAR_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
