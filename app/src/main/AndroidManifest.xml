<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Storage / audio library access
      Justification: core feature — scan and play the user's local music library
      (Music/, Download/, user-configured roots). No other media types are read.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
      Write tags into local audio files (edit song/album metadata).
      Runtime-grantable through API 28; on API 29+ pair with requestLegacyExternalStorage
      and/or MANAGE_EXTERNAL_STORAGE for full file tag rewrites.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      All-files access (API 30+)
      Justification: rewrite embedded tags (title/artist/year/cover) in the user's
      own music files under Music/. Without this, scoped storage blocks File writes
      even when the user explicitly edits metadata in-app.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
      Network
      Justification: optional metadata enrichment (MusicBrainz year, Cover Art
      Archive images) and remote library / scrobbler connections.
      ACCESS_NETWORK_STATE: decide Wi‑Fi vs metered before large library syncs.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Foreground playback + library sync
      mediaPlayback: keep music playing with controls when backgrounded.
      dataSync: long local / Jellyfin / Subsonic library scans with a live notification.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- API 33+ notifications for scan progress -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Wake lock
      Justification: hold a partial wake lock during active playback so the
      CPU is not suspended mid-track on some devices.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".YuriPlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.YuriPlayer">

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:theme="@style/Theme.YuriPlayer"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="capital.yuri.yuriplayer.action.CAR_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.MusicService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".data.LibraryScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
