# Bump / edit these to force a FFmpeg rebuild. Gradle caches on this file + build.sh.
FFMPEG_VERSION=7.1.1
FFMPEG_API_LEVEL=27
# Space-separated enable flags (no --prefix / toolchain here — build.sh owns those)
FFMPEG_ENABLE=--disable-everything --enable-protocol=file --enable-demuxer=image2 --enable-demuxer=gif --enable-demuxer=png_pipe --enable-demuxer=image_jpeg_pipe --enable-decoder=gif --enable-decoder=png --enable-decoder=mjpeg --enable-decoder=rawvideo --enable-encoder=gif --enable-encoder=mjpeg --enable-encoder=png --enable-muxer=gif --enable-muxer=image2 --enable-muxer=mjpeg --enable-filter=scale --enable-filter=crop --enable-filter=format --enable-parser=gif --enable-parser=mjpeg --enable-parser=png
